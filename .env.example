# Copia este archivo como .env.local para desarrollo local
# .env.local NO se sube a git (está en .gitignore)

# URL base de la API de Hostinger.
# En desarrollo: déjalo vacío → Vite proxea /api a app.zensoci.com automáticamente
# En producción: usa .env.production (ya configurado en el repo)
VITE_API_ORIGIN=

# ─────────────────────────────────────────────────────────────────
# Facturación Electrónica — Firmador DTE (PHP backend / Hostinger)
# Estas variables las lee el backend PHP vía getenv(), NO el frontend.
# Configurarlas en: Hostinger → Administrador de archivos → .htaccess
# o en el panel de variables de entorno de tu hosting.
# ─────────────────────────────────────────────────────────────────

# Habilita la integración con el Firmador Docker (true/false)
DTE_FIRMADOR_ENABLED=true

# URL base del Firmador (sin barra final)
# Local (PHP en la máquina):          http://localhost:8113
# Local (PHP en contenedor Docker):   http://host.docker.internal:8113
DTE_FIRMADOR_URL=http://localhost:8113

# Timeout de las peticiones al Firmador (segundos)
DTE_FIRMADOR_TIMEOUT_SECONDS=8

# Entorno de la integración DTE: local | staging | production
# El endpoint POST /firmador-probar.php solo funciona con DTE_ENV=local
DTE_ENV=local

# Credenciales de prueba para el endpoint de diagnóstico (DTE_ENV=local únicamente)
# NUNCA usar credenciales reales aquí — solo para pruebas diagnósticas locales
# NIT sin guiones:
DTE_FIRMADOR_TEST_NIT=
# Contraseña del certificado de prueba:
DTE_FIRMADOR_TEST_PASSWORD=
