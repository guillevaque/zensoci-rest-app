# svfe-api.env.example — Variables de entorno para el Firmador Docker
#
# Copiar como svfe-api.env y completar con valores reales.
# NUNCA subir svfe-api.env al repositorio — contiene secretos.

# NIT del emisor (sin guiones)
NIT=00000000000000

# Contraseña del certificado digital (.p12) asignada al momento de generarlo en el MH
PASSWORD_CERTIFICADO=

# Nombre del archivo .p12 dentro de la carpeta montada en /uploads
# Ejemplo: mi-certificado.p12
ARCHIVO_CERTIFICADO=

# Ambiente MH: 00 = pruebas, 01 = producción
AMBIENTE=00
